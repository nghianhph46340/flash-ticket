# ==============================================================================
# FlashTicket - Production Dockerfile (Dùng pre-built layered artifacts, 0 build overhead)
# ==============================================================================
FROM docker.io/library/eclipse-temurin:21-jre-alpine
WORKDIR /app

RUN apk add --no-cache curl tzdata && \
    cp /usr/share/zoneinfo/Asia/Ho_Chi_Minh /etc/localtime && \
    echo "Asia/Ho_Chi_Minh" > /etc/timezone

RUN addgroup -S appgroup && adduser -S appuser -G appgroup
USER appuser

COPY target/dependencies/ ./
COPY target/spring-boot-loader/ ./
COPY target/snapshot-dependencies/ ./
COPY target/application/ ./

EXPOSE 8080

ENV JAVA_OPTS="-XX:+UseSerialGC -XX:MaxRAMPercentage=70.0 -XX:+ExitOnOutOfMemoryError"

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS org.springframework.boot.loader.launch.JarLauncher"]
