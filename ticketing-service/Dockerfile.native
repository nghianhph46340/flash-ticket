# ==============================================================================
# FlashTicket - Native Image Builder (GraalVM Community 21)
# ==============================================================================
FROM ghcr.io/graalvm/native-image-community:21 AS builder

WORKDIR /build

RUN microdnf install -y findutils gcc glibc-devel zlib-devel

COPY mvnw .
COPY .mvn .mvn
COPY pom.xml .

RUN chmod +x mvnw

# Cache dependencies
RUN ./mvnw dependency:go-offline -B || true

COPY src src

# Biên dịch tĩnh AOT ra mã máy nhị phân ELF độc lập
RUN ./mvnw -Pnative native:compile -DskipTests -B

# ==============================================================================
# Runtime: Distroless Base Debian 12 (Siêu nhẹ, không JVM, không Shell)
# ==============================================================================
FROM gcr.io/distroless/base-debian12:nonroot

WORKDIR /app

# Copy duy nhất binary nhị phân
COPY --from=builder /build/target/ticketing-service /app/application

EXPOSE 8080

USER nonroot:nonroot

ENTRYPOINT ["/app/application"]
